{
  "dockerFile": "${localWorkspaceFolder}/.devcontainer/Dockerfile",
  "build": {
    "args": {
      "BASE": "ghcr.io/rust-cross/rust-musl-cross:aarch64-musl",
      "CARGO_BUILD_TARGET": "aarch64-unknown-linux-musl",
      "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
    },
    "options": [
      "--platform",
      "linux/arm64"
    ]
  },
  "capAdd": ["SYS_ADMIN", "SYS_PTRACE"],
  "hostRequirements": { "gpu": "optional" },
  "securityOpt": ["apparmor=unconfined", "seccomp=unconfined"],
  "runArgs": [
    "--rm",
    "--name",
    "${localEnv:USER:anon}-${localWorkspaceFolderBasename}-cuda12.9-arm64",
    "--network",
    "host",
    "--platform",
    "linux/arm64",
    "--privileged",
    "--ulimit",
    "nofile=1048576:1048576"
  ],
  "remoteUser": "${localEnv:USER:anon}",
  "containerUser": "root",
  "initializeCommand": [
    "/bin/bash",
    "-c",
    "if test arm64 != $(dpkg --print-architecture | awk -F'-' '{print $NF}'); then docker run --privileged --rm tonistiigi/binfmt --install arm64; fi; mkdir -m 0755 -p ${localWorkspaceFolder}/.devcontainer/{bin,.cache,.config}"
  ],
  "postCreateCommand": [
    "/bin/bash",
    "+o",
    "history",
    "sccache-post-create-command"
  ],
  "workspaceFolder": "/opt/sccache",
  "workspaceMount": "type=bind,src=${localWorkspaceFolder},dst=${localWorkspaceFolder}",
  "mounts": [
    "type=bind,src=/tmp,dst=/tmp"
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.6": {
      "userUid": "1001",
      "userGid": "1001",
      "username": "${localEnv:USER:anon}",
      "installZsh": "false",
      "upgradePackages": "true"
    },
    "ghcr.io/devcontainers/features/git:1.3.5": {
      "ppa": "true",
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.6.5": {
      "moby": "false"
    },
    "ghcr.io/rapidsai/devcontainers/features/gcc:latest": {},
    "ghcr.io/rapidsai/devcontainers/features/llvm:latest": {
      "version": "19"
    },
    "ghcr.io/rapidsai/devcontainers/features/cuda:latest": {
      "version": "12.9",
      "installCompilers": "true",
      "installProfilers": "false",
      "installCTKLibraries": "false",
      "installDevPackages": "true",
      "installNCCL": "false",
      "installCUDARuntime": "true",
      "pruneStaticLibs": "true"
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/devcontainers/features/git",
    "ghcr.io/devcontainers/features/github-cli",
    "ghcr.io/devcontainers/features/docker-outside-of-docker",
    "ghcr.io/rapidsai/devcontainers/features/gcc",
    "ghcr.io/rapidsai/devcontainers/features/llvm",
    "ghcr.io/rapidsai/devcontainers/features/cuda"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "augustocdias.tasks-shell-input",
        "bierner.markdown-mermaid",
        "mutantdino.resourcemonitor",
        "rust-lang.rust-analyzer",
        "fill-labs.dependi",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "debug.toolBarLocation": "docked",
        "extensions.ignoreRecommendations": true,
        "files.watcherExclude": {
          "**/build/**": true,
          "**/target/**": true,
          "${localEnv:HOME}/.cache/**/*": true,
          "${localEnv:HOME}/.local/share/**/*": true,
          "${localEnv:HOME}/.vscode-server/**/*": true
        },
        "[rust]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "lldb.launch.preRunCommands": [
            "script lldb.debugger.HandleCommand('settings set target.source-map /rustc/{} \"{}/lib/rustlib/src/rust\"'.format(os.popen('rustc --version --verbose').read().split('commit-hash: ')[1].split('\\n')[0].strip(), os.popen('rustc --print sysroot').readline().strip()))"
        ],
        "rust-analyzer.initializeStopped": true,
        "rust-analyzer.cachePriming.enable": false,
        "rust-analyzer.cargo.cfgs": [
            "test"
        ],
        "rust-analyzer.cargo.allTargets": true,
        "rust-analyzer.cargo.target": "x86_64-unknown-linux-musl",
        "rust-analyzer.cargo.features": [
            "all",
            "vendored-openssl",
            "dist-client",
            "dist-server",
            "dist-tests"
        ],
        "rust-analyzer.cargo.extraEnv": {
            "CC": "gcc",
            "CXX": "g++"
        },
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.check.extraEnv": {
            "CC": "gcc",
            "CXX": "g++"
        },
        "rust-analyzer.server.extraEnv": {
            "CC": "gcc",
            "CXX": "g++"
        },
        "rust-analyzer.runnables.extraEnv": {
            "CC": "gcc",
            "CXX": "g++"
        },
        "rust-analyzer.cargo.targetDir": true,
        "rust-analyzer.checkOnSave": true,
        "search.exclude": {
          "**/build/**": true,
          "**/target/**": true,
          "**/*.code-search": true,
          "${localEnv:HOME}/.cache/**/*": true,
          "${localEnv:HOME}/.local/share/**/*": true,
          "${localEnv:HOME}/.vscode-server/**/*": true
        },
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash",
            "args": ["-l"]
          }
        }
      }
    }
  }
}
